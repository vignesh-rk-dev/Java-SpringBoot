<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <import resource="Salarybean.xml"/>  <!-- Import salary bean -->

    <bean id="employee" class="com.vignesh.Employee">
        <property name="empNumber" value="101"/>
        <property name="empName" value="Raju"/>
        <property name="salary" ref="salary"/>  <!-- Correct reference -->
    </bean>

</beans>
